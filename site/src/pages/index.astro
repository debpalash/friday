---
import versionFile from "../../../VERSION?raw";
import Base from "../layouts/Base.astro";
import logo from "../../../assets/friday.svg";
import interfaceImage from "../assets/og.png";

const version = versionFile.trim();
const repository = "https://github.com/debpalash/friday";
const docs = `${repository}/tree/main/docs`;
const title = "Friday — a local assistant for your workstation";
const description =
  "Friday is a private voice and text assistant that runs locally on Linux or macOS, remembers context, and uses approved tools on your workstation.";
const linuxCommand = "curl -fsSL https://friday.palash.dev/install | bash";
const windowsCommand = "irm https://friday.palash.dev/install.ps1 | iex";
---

<Base title={title} description={description} path="/">
  <header class="site-header">
    <a class="brand" href="/" aria-label="Friday home">
      <img src={logo.src} width="28" height="28" alt="" />
      <span>Friday</span>
    </a>
    <nav aria-label="Primary">
      <a href={docs}>Docs</a>
      <a href={repository} rel="noopener">GitHub</a>
    </nav>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="hero-heading">
      <p class="status">Linux · macOS · local · developer preview</p>
      <h1 id="hero-heading">Your computer,<br />with a voice.</h1>
      <p class="intro">
        Talk, type, and hand off work. Friday runs on your machine, remembers
        context, and asks before it changes anything.
      </p>

      <div class="install" aria-label="Linux and macOS install command">
        <code>{linuxCommand}</code>
        <button type="button" data-copy={linuxCommand} aria-label="Copy the Linux and macOS install command">
          Copy
        </button>
      </div>

      <p class="requirements">
        Linux x86_64 with an NVIDIA GPU (22+ GiB VRAM) · macOS 14+ on Apple
        Silicon (16+ GiB unified memory)
      </p>

      <details>
        <summary>Windows via WSL 2</summary>
        <div class="windows-command">
          <code>{windowsCommand}</code>
          <button type="button" data-copy={windowsCommand} aria-label="Copy the Windows install command">
            Copy
          </button>
        </div>
        <p>WSL 2 is available as an unqualified preview target.</p>
      </details>
    </section>

    <figure class="product">
      <img
        src={interfaceImage.src}
        width={interfaceImage.width}
        height={interfaceImage.height}
        alt="Friday showing a release plan, checklist, and evidence table beside its voice orb"
        decoding="async"
      />
      <figcaption>The shipped interface. Synthetic data.</figcaption>
    </figure>

    <section class="principles" aria-label="What Friday does">
      <article>
        <p class="number">01</p>
        <h2>Local</h2>
        <p>Conversation, speech, and memory stay on your workstation.</p>
      </article>
      <article>
        <p class="number">02</p>
        <h2>Useful</h2>
        <p>Files, documents, the web, reminders, and your Omarchy desktop.</p>
      </article>
      <article>
        <p class="number">03</p>
        <h2>Accountable</h2>
        <p>Approval before a sensitive action. A receipt after it runs.</p>
      </article>
    </section>

    <section class="boundary" aria-labelledby="boundary-heading">
      <h2 id="boundary-heading">Built for one machine.</h2>
      <div>
        <p>
          Friday binds to loopback, has no telemetry, and does not require hosted
          inference. It is early software and has not received an independent
          security audit.
        </p>
        <a href={`${repository}/blob/main/docs/privacy.md`}>Read the privacy model <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <p>Friday {version} · Apache-2.0</p>
    <nav aria-label="Footer">
      <a href={`${repository}/releases`}>Releases</a>
      <a href={`${repository}/blob/main/SECURITY.md`}>Security</a>
      <a href={`${repository}/discussions`}>Discuss</a>
    </nav>
  </footer>
</Base>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    button.addEventListener("click", async () => {
      const label = button.textContent;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select";
      }
      window.setTimeout(() => (button.textContent = label), 1600);
    });
  }
</script>

<style>
  .site-header,
  main,
  .site-footer {
    width: min(72rem, calc(100% - 3rem));
    margin-inline: auto;
  }

  .site-header {
    min-height: 5.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--fg);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .brand:hover,
  .brand:focus-visible {
    text-decoration: none;
  }

  .brand img {
    border: 1px solid var(--line-strong);
    border-radius: 7px;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  nav a {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .hero {
    max-width: 54rem;
    padding: clamp(5rem, 11vw, 9rem) 0 clamp(4rem, 8vw, 7rem);
  }

  .status,
  .number {
    margin: 0 0 1.35rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 13ch;
    margin: 0;
    font-size: clamp(3.4rem, 9vw, 7rem);
    font-weight: 560;
    letter-spacing: -0.065em;
    line-height: 0.93;
  }

  .intro {
    max-width: 37rem;
    margin: 2rem 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    line-height: 1.55;
  }

  .install,
  .windows-command {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
  }

  .install {
    max-width: 48rem;
    margin-top: 2.5rem;
    padding: 0.65rem 0.65rem 0.65rem 1.1rem;
  }

  .install code,
  .windows-command code {
    min-width: 0;
    overflow-x: auto;
    color: var(--fg);
    font-size: 0.9rem;
    line-height: 1.4;
    white-space: nowrap;
    scrollbar-width: thin;
  }

  button {
    min-width: 5.5rem;
    min-height: 2.75rem;
    border: 0;
    border-radius: 2px;
    color: #080a0e;
    background: var(--accent);
    font: 650 0.82rem var(--sans);
    cursor: pointer;
  }

  button:hover {
    background: var(--fg);
  }

  .requirements {
    margin: 0.9rem 0 0;
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  details {
    width: max-content;
    max-width: 100%;
    margin-top: 1.4rem;
    color: var(--dim);
    font-size: 0.82rem;
  }

  summary {
    min-height: 2.75rem;
    display: list-item;
    align-content: center;
    color: var(--muted);
    cursor: pointer;
  }

  summary::marker {
    color: var(--accent);
  }

  .windows-command {
    width: min(43rem, calc(100vw - 3rem));
    margin-top: 0.5rem;
    padding: 0.55rem 0.55rem 0.55rem 0.9rem;
  }

  details p {
    margin: 0.6rem 0 0;
  }

  .product {
    margin: 0;
    border-top: 1px solid var(--line);
    padding: clamp(3rem, 7vw, 6rem) 0;
  }

  .product img {
    width: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: #090c12;
  }

  .product figcaption {
    margin-top: 0.8rem;
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.7rem;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line-strong);
    border-bottom: 1px solid var(--line-strong);
  }

  .principles article {
    min-width: 0;
    padding: 2.4rem 2.2rem 2.7rem 0;
  }

  .principles article + article {
    border-left: 1px solid var(--line);
    padding-left: 2.2rem;
  }

  .principles .number {
    margin-bottom: 2.5rem;
  }

  .principles h2 {
    margin: 0 0 0.7rem;
    font-size: 1.15rem;
    font-weight: 620;
  }

  .principles article > p:last-child {
    max-width: 20rem;
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .boundary {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 2rem 5rem;
    align-items: start;
    padding: clamp(4.5rem, 9vw, 8rem) 0;
  }

  .boundary h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 560;
    letter-spacing: -0.045em;
  }

  .boundary p {
    margin: 0 0 1.4rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .boundary a {
    font-size: 0.9rem;
  }

  .site-footer {
    min-height: 7rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-top: 1px solid var(--line);
    color: var(--dim);
    font-family: var(--mono);
    font-size: 0.72rem;
  }

  .site-footer p {
    margin: 0;
  }

  .site-footer nav a {
    font-family: var(--sans);
    font-size: 0.8rem;
  }

  @media (max-width: 700px) {
    .site-header,
    main,
    .site-footer {
      width: min(100% - 2rem, 72rem);
    }

    .site-header {
      min-height: 4.75rem;
    }

    .site-header nav {
      gap: 1rem;
    }

    .hero {
      padding-top: 4.5rem;
    }

    h1 {
      font-size: clamp(3rem, 16vw, 4.5rem);
    }

    .install,
    .windows-command {
      grid-template-columns: 1fr;
      padding: 0;
      gap: 0;
      background: transparent;
      border: 0;
    }

    .install code,
    .windows-command code {
      padding: 1rem;
      border: 1px solid var(--line-strong);
      background: var(--surface);
    }

    .install button,
    .windows-command button {
      width: 100%;
      margin-top: 0.5rem;
    }

    .requirements {
      max-width: 32rem;
      line-height: 1.6;
    }

    .windows-command {
      width: calc(100vw - 2rem);
    }

    .principles {
      grid-template-columns: 1fr;
    }

    .principles article {
      padding: 2rem 0;
    }

    .principles article + article {
      border-top: 1px solid var(--line);
      border-left: 0;
      padding-left: 0;
    }

    .principles .number {
      margin-bottom: 1.5rem;
    }

    .boundary {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .site-footer {
      min-height: auto;
      align-items: flex-start;
      flex-direction: column;
      padding: 2rem 0 2.5rem;
    }

    .site-footer nav {
      flex-wrap: wrap;
      gap: 0.7rem 1.2rem;
    }
  }
</style>
