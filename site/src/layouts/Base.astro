---
import versionFile from "../../../VERSION?raw";
import logo from "../../../assets/friday.svg";
import ogImage from "../assets/og.png";

interface Props {
  title: string;
  description: string;
  /** Canonical path, for example "/" or "/404". */
  path?: string;
  noindex?: boolean;
}

const site = Astro.site ?? new URL("https://friday.palash.dev");
const { title, description, path = "/", noindex = false } = Astro.props;
const canonical = new URL(path === "/" ? "/" : path, site).href;
const version = versionFile.trim();
const repository = "https://github.com/debpalash/friday";
const ogUrl = new URL(ogImage.src, site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Friday",
      description,
      url: site.href,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Linux x86_64",
      softwareVersion: version,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      downloadUrl: `${repository}/releases`,
      installUrl: `${site.href}install`,
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      softwareRequirements:
        "NVIDIA GPU with at least 22 GiB VRAM, systemd user session, about 50 GiB free disk",
      image: ogUrl,
      sameAs: [repository],
    },
    {
      "@type": "WebSite",
      name: "Friday",
      url: site.href,
    },
  ],
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    <meta name="theme-color" content="#07090d" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Palash Debnath" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Friday" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content="The Friday interface answering a text request with a checklist and table" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #07090d;
    --bg-soft: #0c1018;
    --panel: rgba(15, 20, 31, 0.78);
    --panel-solid: #111722;
    --panel-high: #171e2c;
    --line: rgba(170, 190, 225, 0.12);
    --line-strong: rgba(170, 190, 225, 0.22);
    --fg: #f1f5fb;
    --fg-soft: #c3ccda;
    --dim: #7f8999;
    --accent: #8eb8ff;
    --accent-strong: #5d8ff0;
    --ok: #74dfb0;
    --amber: #ffc878;
    --violet: #b79cff;
    --warn: #ff8098;
    --shadow: 0 28px 80px rgba(0, 0, 0, 0.38);
    --radius: 18px;
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    --measure: 68rem;
    color-scheme: dark;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    font-family: var(--sans);
    font-size: 17px;
    line-height: 1.6;
    color: var(--fg-soft);
    background:
      radial-gradient(60rem 40rem at 15% -10%, rgba(93, 143, 240, 0.16), transparent 60%),
      radial-gradient(50rem 30rem at 110% 20%, rgba(183, 156, 255, 0.1), transparent 55%),
      var(--bg);
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3 { color: var(--fg); line-height: 1.15; letter-spacing: -0.015em; margin: 0 0 0.5em; }
  h2 { font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem); }
  h3 { font-size: 1.1rem; }
  p { margin: 0 0 1em; }
  a { color: var(--accent); text-decoration: none; }
  a:hover, a:focus-visible { text-decoration: underline; text-underline-offset: 0.2em; }
  code, pre, kbd { font-family: var(--mono); font-size: 0.92em; }
  code { background: rgba(170, 190, 225, 0.1); padding: 0.1em 0.4em; border-radius: 6px; }
  pre { margin: 0; overflow-x: auto; }
  pre code { background: none; padding: 0; }
  img { max-width: 100%; height: auto; display: block; }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.65rem 0.8rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  th { color: var(--fg); font-weight: 600; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .skip {
    position: absolute; left: -999px; top: 0; background: var(--accent-strong); color: #fff;
    padding: 0.5rem 1rem; border-radius: 0 0 10px 0; z-index: 10;
  }
  .skip:focus { left: 0; }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
  }
</style>
