---
import versionFile from "../../../VERSION?raw";
import logo from "../../../assets/friday.svg";
import ogImage from "../assets/og.png";

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}

const site = Astro.site ?? new URL("https://friday.palash.dev");
const { title, description, path = "/", noindex = false } = Astro.props;
const canonical = new URL(path === "/" ? "/" : path, site).href;
const version = versionFile.trim();
const repository = "https://github.com/debpalash/friday";
const ogUrl = new URL(ogImage.src, site).href;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "Friday",
      description,
      url: site.href,
      applicationCategory: "UtilitiesApplication",
      operatingSystem: "Linux x86_64",
      softwareVersion: version,
      license: "https://www.apache.org/licenses/LICENSE-2.0",
      downloadUrl: `${repository}/releases`,
      installUrl: `${site.href}install`,
      isAccessibleForFree: true,
      offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      softwareRequirements:
        "NVIDIA GPU with at least 22 GiB VRAM, systemd user session, about 50 GiB free disk",
      image: ogUrl,
      sameAs: [repository],
    },
    { "@type": "WebSite", name: "Friday", url: site.href },
  ],
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index,follow,max-image-preview:large" />}
    <meta name="theme-color" content="#090a0d" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Palash Debnath" />
    <link rel="icon" type="image/svg+xml" href={logo.src} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Friday" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content={String(ogImage.width)} />
    <meta property="og:image:height" content={String(ogImage.height)} />
    <meta property="og:image:alt" content="The Friday interface showing a release plan and evidence table" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #090a0d;
    --surface: #0f1116;
    --line: #20232b;
    --line-strong: #30343e;
    --fg: #f2f1ed;
    --muted: #a6a7ad;
    --dim: #8b8e97;
    --accent: #91b6ff;
    --sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    color-scheme: dark;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-width: 20rem;
    min-height: 100vh;
    margin: 0;
    color: var(--fg);
    background: var(--bg);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover,
  a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  code,
  pre,
  kbd {
    font-family: var(--mono);
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  ::selection {
    color: #090a0d;
    background: var(--accent);
  }

  .skip {
    position: fixed;
    top: 0.75rem;
    left: -999px;
    z-index: 20;
    padding: 0.65rem 0.9rem;
    color: #090a0d;
    background: var(--accent);
  }

  .skip:focus {
    left: 0.75rem;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
