[Unit]
Description=Friday private local assistant (legacy unit)
After=network-online.target graphical-session.target

[Service]
Type=simple
KillMode=control-group
WorkingDirectory=%h/.local/share/friday/current
EnvironmentFile=-%h/.config/friday/friday.env
ExecStart=%h/.local/share/friday/current/venv/bin/python %h/.local/share/friday/current/supervisor.py watch
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=default.target
